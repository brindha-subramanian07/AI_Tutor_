# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_tutor
# For SQLite local dev fallback:
# DATABASE_URL=sqlite:///./ai_tutor.db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# JWT Authentication
JWT_SECRET_KEY=ai_tutor_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Sandbox Code Execution
CODE_EXECUTION_TIMEOUT=5
